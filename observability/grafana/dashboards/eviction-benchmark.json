{
  "title": "Eviction Policy Benchmark",
  "uid": "dcg-eviction-bench",
  "schemaVersion": 38,
  "refresh": "5s",
  "description": "Compare LRU, LFU, TTL-only, and Random eviction policies under the same workload. Each line represents one policy.",
  "panels": [
    {
      "id": 1,
      "title": "Hit Rate by Eviction Policy",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{
        "expr": "rate(dcg_cache_hits_total[1m]) / (rate(dcg_cache_hits_total[1m]) + rate(dcg_cache_misses_total[1m]))",
        "legendFormat": "{{eviction_policy}}"
      }],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 2,
      "title": "Miss Rate by Eviction Policy",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{
        "expr": "rate(dcg_cache_misses_total[1m]) / (rate(dcg_cache_hits_total[1m]) + rate(dcg_cache_misses_total[1m]))",
        "legendFormat": "{{eviction_policy}}"
      }],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 3,
      "title": "Eviction Count by Policy",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [{
        "expr": "rate(dcg_cache_evictions_total[1m])",
        "legendFormat": "{{eviction_policy}}"
      }]
    },
    {
      "id": 4,
      "title": "p99 Get Latency by Policy (ms)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(dcg_cache_operation_duration_seconds_bucket{operation=\"get\"}[1m])) * 1000",
        "legendFormat": "{{eviction_policy}}"
      }],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    }
  ]
}
