{
  "title": "Eviction Policy Benchmark",
  "uid": "dcg-eviction-bench",
  "schemaVersion": 38,
  "refresh": "5s",
  "description": "Compare LRU, LFU, TTL-only, and Random eviction policies under the same workload. Each line represents one policy.",
  "panels": [
    {
      "id": 1,
      "title": "Hit Rate by Eviction Policy",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{
        "expr": "rate(dcg_cache_hits_total[1m]) / (rate(dcg_cache_hits_total[1m]) + rate(dcg_cache_misses_total[1m]))",
        "legendFormat": "{{eviction_policy}}"
      }],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 2,
      "title": "Miss Rate by Eviction Policy",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{
        "expr": "rate(dcg_cache_misses_total[1m]) / (rate(dcg_cache_hits_total[1m]) + rate(dcg_cache_misses_total[1m]))",
        "legendFormat": "{{eviction_policy}}"
      }],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 3,
      "title": "Eviction Count by Policy",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [{
        "expr": "rate(dcg_cache_evictions_total[1m])",
        "legendFormat": "{{eviction_policy}}"
      }]
    },
    {
      "id": 4,
      "title": "p99 Get Latency by Policy (ms)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(dcg_cache_operation_duration_seconds_bucket{operation=\"get\"}[1m])) * 1000",
        "legendFormat": "{{eviction_policy}}"
      }],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    },
    {
      "id": 5,
      "title": "Hit Rate Comparison by Policy (current)",
      "description": "Side-by-side hit rate for each eviction policy at the current moment. Use this to compare policy effectiveness at a glance.",
      "type": "bargauge",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "rate(dcg_cache_hits_total[5m]) / (rate(dcg_cache_hits_total[5m]) + rate(dcg_cache_misses_total[5m]))",
          "legendFormat": "{{eviction_policy}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.8},
              {"color": "green", "value": 0.95}
            ]
          }
        }
      }
    }
  ]
}
